# Copy to backend/.env and fill in. Every variable is prefixed TREFFIT_.

# --- required in production ---
TREFFIT_SECRET_KEY=change-me-to-a-long-random-string
TREFFIT_BOT_TOKEN=123456:your-telegram-bot-token
TREFFIT_DATABASE_URL=postgresql+asyncpg://treffit:treffit@localhost:5432/treffit

# --- product rules ---
# true  = Treffit mode: photos hidden until the chat threshold is crossed
# false = classic Twinby mode: photos visible in the deck straight away
TREFFIT_BLIND_MODE=true
TREFFIT_REVEAL_THRESHOLD=3
TREFFIT_MIN_AGE=18
TREFFIT_MAX_PHOTOS=6
TREFFIT_DAILY_LIKE_LIMIT=50
TREFFIT_DAILY_LIKE_LIMIT_PREMIUM=500

# --- storage ---
TREFFIT_MEDIA_ROOT=var/media
TREFFIT_MAX_PHOTO_BYTES=8388608

# --- live mode ---
TREFFIT_LIVE_RADIUS_METERS=700
TREFFIT_LIVE_WINDOW_HOURS=2

# --- misc ---
TREFFIT_CORS_ORIGINS=https://your-mini-app-domain
TREFFIT_DEBUG=false

# DANGER: lets anyone mint a session for any telegram_id. Local dev only.
TREFFIT_ALLOW_DEV_AUTH=false
