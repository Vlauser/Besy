{
  "name": "besy",
  "version": "1.0.0",
  "private": true,
  "description": "Besy - self-hosted video hosting platform",
  "type": "commonjs",
  "main": "server/index.js",
  "scripts": {
    "start": "node --experimental-sqlite server/index.js",
    "dev": "node --experimental-sqlite --watch server/index.js",
    "smoke": "node scripts/smoke.js",
    "smoke:security": "node scripts/smoke-security.js",
    "smoke:social": "node scripts/smoke-social.js",
    "test": "node scripts/smoke.js && node scripts/smoke-security.js && node scripts/smoke-social.js",
    "admin": "node --experimental-sqlite scripts/make-admin.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "hls.js": "^1.7.1",
    "multer": "^2.2.0",
    "qrcode": "^1.5.4"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "node-media-server": "^4.2.8",
    "nodemailer": "^9.0.5"
  }
}
