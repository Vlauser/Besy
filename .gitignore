# Локальный роутер для php -S, на сервере не нужен
_dev-router.php

# Резервные копии, которые CMS кладёт рядом при каждом сохранении
data/*.bak.json

# Рабочие файлы, которые сайт создаёт сам на сервере.
# В репозитории и в архиве их быть не должно: users.json хранит
# логины администраторов, leads.json — заявки клиентов.
data/users.json
data/leads.json
data/ratelimit.json
data/throttle.json

# Локальная настройка путей на конкретном сервере.
# Не попадает в архив, поэтому переживает обновление сайта.
config.local.php
