# Copy to .env and fill in. Everything here is read by docker compose.

# The name the certificate is issued for. Point its A/AAAA record at this host
# before starting, or Caddy will keep retrying.
BESY_DOMAIN=besy.example.com

# Written into the links inside e-mails, so it must be the address people use.
BESY_PUBLIC_URL=https://besy.example.com

# Signs playback links. Generate once and keep it:
#   openssl rand -hex 32
# Without it the key is derived per data directory, which is fine on a laptop
# and wrong on a server.
BESY_SECRET=

# --- mail -------------------------------------------------------------------
# Without SMTP the letters land in /data/outbox inside the volume, which is
# enough to try things out and not enough to run anything real: nobody can
# confirm their address or reset a password.
BESY_MAIL_TRANSPORT=log
# BESY_MAIL_TRANSPORT=smtp
# BESY_SMTP_HOST=
# BESY_SMTP_PORT=587
# BESY_SMTP_USER=
# BESY_SMTP_PASSWORD=
# BESY_MAIL_FROM=Besy <no-reply@besy.example.com>

# --- live -------------------------------------------------------------------
# Off by default. On means the container listens for RTMP on 1935, and the
# ingest address handed to streamers is built from this host name.
# BESY_LIVE=on
# BESY_RTMP_HOST=besy.example.com

# --- limits -----------------------------------------------------------------
# BESY_MAX_UPLOAD_MB=2048          # keep Caddyfile's max_size at least this
# BESY_TRANSCODE_CONCURRENCY=1     # ffmpeg jobs at once; raise on more cores
