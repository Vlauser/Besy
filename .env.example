# --- Claude API ---
# Ключ лежит на сервере и в браузер не попадает. Токены тратите вы.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
# Контроль качества + OCR маркировки. false — только алгоритмическая обработка, без токенов.
ENABLE_CLAUDE=true
# low хватает для чтения маркировки и проверки выреза
CLAUDE_EFFORT=low

# --- Доступ ---
# Пустое значение = сайт открыт всем, кто знает адрес, и все они тратят ваш ключ.
# На публичном VPS задайте пароль.
APP_PASSWORD=

# --- Формат результата ---
CANVAS_WIDTH=812
CANVAS_HEIGHT=677
FILL_HEIGHT=0.69
FILL_WIDTH_MAX=0.88
JPEG_QUALITY=92
BACKGROUND=#FFFFFF

# --- Сегментация ---
REMBG_MODEL=isnet-general-use
ALPHA_THRESHOLD=12
MIN_COMPONENT_RATIO=0.02

# Отсечение тени. Сегментатор отдаёт мягкую тень не как фон, а как
# полупрозрачные пиксели (альфа ~20-90) — без этих порогов она легла бы
# на белый холст серой дымкой.
# Ядро детали: что считаем уверенно деталью.
ALPHA_CORE_THRESHOLD=160
# Кривая жёсткости: ниже LOW -> прозрачно, выше HIGH -> непрозрачно.
# Поднимите LOW, если тень всё же просвечивает; опустите, если съедает край.
ALPHA_SOFT_LOW=90
ALPHA_SOFT_HIGH=160
# Ширина полосы вокруг ядра, где ещё разрешена полупрозрачность (сглаживание края)
EDGE_BAND_PX=3

# --- Очередь ---
# Каждый воркер держит свою ONNX-сессию: 2 воркера ≈ 2 ГБ RAM.
WORKERS=2
MAX_FILES_PER_JOB=300
MAX_UPLOAD_MB=40
